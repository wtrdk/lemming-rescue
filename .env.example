# Kopieer alleen bij een nieuwe installatie naar .env.
# Behoud bij een upgrade je bestaande .env; commit nooit echte wachtwoorden.

# Hostbinding: loopback voor lokaal gebruik/Nginx Proxy Manager.
# Voor direct LAN-gebruik op t-rex: 192.168.2.75.
LEMMING_RESCUE_BIND=127.0.0.1
# Hostpoort. De container blijft intern op 8080 luisteren.
# Voor het bestaande LAN-adres op t-rex: 8280.
LEMMING_RESCUE_PORT=8080

# Eerste account; wordt alleen gemaakt als de gebruikerstabel leeg is.
LEMMING_RESCUE_USERNAME=wtrdk
# Vul bij de eerste start een uniek wachtwoord van 12–256 tekens in.
# Na aanmaken kun je deze waarde uit .env verwijderen.
LEMMING_RESCUE_PASSWORD=

# Dagelijkse back-ups in ./backups, om 03:00 Nederlandse tijd.
LEMMING_BACKUP_KEEP_DAYS=14
LEMMING_BACKUP_HOUR=3
LEMMING_BACKUP_TIMEZONE=Europe/Amsterdam
